# Python bytecode
__pycache__/
*.py[cod]

# fnpack leaves an unversioned artifact inside the source tree before
# build-fpk.sh renames it.  Neither that file nor dist/ belongs in the repo.
package/*.fpk

# Release archives produced by the packaging helper
/*.tar.gz
/*.zip
/dist/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~

# Local scratch
/build/
/scratch/

# Delivery notes live beside the source tree in the workspace, not in the repo.
/交付说明.md
/说明.md
